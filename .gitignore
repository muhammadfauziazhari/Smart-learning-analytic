# Root repository (monorepo).
# Pengaturan khusus tiap aplikasi ada di laravel/.gitignore dan
# analytics/.gitignore.

# --- Analytics (Python) ---
analytics/.venv/
analytics/**/__pycache__/
analytics/**/*.pyc
analytics/.pytest_cache/
analytics/.env

# --- Editor & OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Cache Vite
.vite/
laravel/.vite/

# Data contoh log LMS. TIDAK ikut di-commit: berisi NIM/NIP
# yang merupakan data pribadi.
sample-data/
laravel/sample-data/
